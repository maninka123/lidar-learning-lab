# Copy to .env.local for local testing. In production set these in the Vercel dashboard
# (Project -> Settings -> Environment Variables). Never commit real values.

# A DEDICATED DeepSeek key, created just for workshops. Revoke it afterwards.
DEEPSEEK_API_KEY=

# Redis store (Upstash, added from the Vercel Marketplace; either pair of names works)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Admin login: a scrypt hash of your password (run: npm run hash-password) and a random secret (32+ characters)
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_AUTH_SECRET=

# Where the student app is hosted. Comma-separate several origins if needed.
FRONTEND_ORIGIN=https://maninka123.github.io
