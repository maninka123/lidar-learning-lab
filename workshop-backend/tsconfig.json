{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "types": [
      "node"
    ],
    "esModuleInterop": true
  },
  "include": [
    "api",
    "lib",
    "tests",
    "scripts"
  ]
}
